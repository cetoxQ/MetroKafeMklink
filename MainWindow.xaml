<Window x:Class="MetroKafeMklink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MetroKafeMklink.Views"
        Title="MetroKafe Mklink" Width="1200" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        StateChanged="Window_StateChanged" KeyDown="Window_KeyDown" Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Sol menu -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,26,0,30">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MetroKafe" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Mklink Yöneticisi" FontSize="11.5" Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="24,0,20,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AdminIcon" Text="&#xE83D;" Style="{StaticResource Icon}" FontSize="12"/>
                        <TextBlock x:Name="AdminText" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" FontSize="11.5" Foreground="{StaticResource FaintTextBrush}" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavLinks" Style="{StaticResource NavItem}" Tag="&#xE71B;" Content="Mklink"
                                 GroupName="nav" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavRegistry" Style="{StaticResource NavItem}" Tag="&#xE943;" Content="Registry"
                                 GroupName="nav" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Ayarlar"
                                 GroupName="nav" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavUpdate" Style="{StaticResource NavItem}" Tag="&#xE895;"
                                 GroupName="nav" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Güncelleme"/>
                            <Border x:Name="UpdateDot" Width="7" Height="7" CornerRadius="4" Margin="8,1,0,0"
                                    Background="{StaticResource AccentBrush}" Visibility="Collapsed" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Icerik -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Simge durumuna küçült"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Büyüt"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Kapat"/>
            </StackPanel>

            <Grid x:Name="PageHost" Grid.Row="1" Margin="32,0,32,16">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PageShift"/>
                </Grid.RenderTransform>
                <v:LinksView x:Name="LinksPage"/>
                <v:RegistryView x:Name="RegistryPage" Visibility="Collapsed"/>
                <v:SettingsView x:Name="SettingsPage" Visibility="Collapsed"/>
                <v:UpdateView x:Name="UpdatePage" Visibility="Collapsed"/>
            </Grid>

            <!-- Islem kaydi -->
            <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="36" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="LogHeader_Click">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="32,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                            <TextBlock Text="İşlem kaydı" Foreground="{StaticResource SubTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="LastLogText" Grid.Column="1" Margin="18,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="LogChevron" Grid.Column="2" Text="&#xE70E;" Style="{StaticResource Icon}"
                                   Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,0,24,0"/>
                    </Grid>
                    <ListBox x:Name="LogList" Height="0" Margin="20,0,20,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="12,3"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource FaintTextBrush}" FontSize="12" Width="64"
                                               FontFamily="Consolas"/>
                                    <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="NoWrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Success">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Iletisim kutusu katmani -->
        <Grid x:Name="Overlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#A6000000">
            <Border x:Name="OverlayCard" Style="{StaticResource Card}" Width="600" MaxHeight="640" Padding="26,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="OverlayScale"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="Black"/>
                </Border.Effect>
                <DockPanel>
                    <TextBlock x:Name="OverlayTitle" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button x:Name="OverlayCancel" Content="Vazgeç" Click="OverlayCancel_Click" MinWidth="96"/>
                        <Button x:Name="OverlayOk" Style="{StaticResource AccentButton}" Margin="10,0,0,0" MinWidth="96" Click="OverlayOk_Click"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                        <ContentControl x:Name="OverlayBody" Focusable="False"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
