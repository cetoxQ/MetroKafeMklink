<UserControl x:Class="MetroKafeMklink.Views.LinksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Baslik -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="Refresh_Click" ToolTip="Durumları yeniden kontrol et (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/>
                        <TextBlock Text="Yenile"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButton}" Margin="10,0,0,0" Click="Add_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}"/>
                        <TextBlock Text="Yeni bağlantı"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Mklink" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Klasör bağlantılarını (junction) tek ekrandan gör, kur ve kaldır" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>

        <!-- Ozet kartlari -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="-6,20,-6,0">
            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Toplam" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                    <TextBlock x:Name="StatTotal" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Bağlı" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                    <TextBlock x:Name="StatLinked" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Bekleyen" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                    <TextBlock x:Name="StatPending" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{StaticResource WarningBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Sorunlu" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                    <TextBlock x:Name="StatProblem" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Arama ve grup filtresi -->
        <DockPanel Grid.Row="2" Margin="0,20,0,12">
            <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="260" Tag="Ara: ad, yol…" TextChanged="Search_TextChanged"
                     VerticalAlignment="Center"/>
            <ListBox x:Name="GroupChips" Style="{StaticResource ChipList}" SelectionChanged="Group_SelectionChanged" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Liste -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="13,8,23,8" TextElement.Foreground="{StaticResource FaintTextBrush}" TextElement.FontSize="11.5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="138"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="DURUM"/>
                    <TextBlock Grid.Column="1" Text="AD"/>
                    <TextBlock Grid.Column="2" Text="BAĞLANTI (JUNCTION)"/>
                    <TextBlock Grid.Column="4" Text="HEDEF (VERİNİN YERİ)"/>
                </Grid>

                <ListBox x:Name="List" Grid.Row="1" SelectionMode="Extended" ItemContainerStyle="{StaticResource RowItem}"
                         SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Detail}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="138"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>

                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Linked">
                                                    <Setter Property="Background" Value="#262BD46A"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Missing">
                                                    <Setter Property="Background" Value="#26F5A524"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="RealFolder">
                                                    <Setter Property="Background" Value="#2638BDF8"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource InfoBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="WrongTarget">
                                                    <Setter Property="Background" Value="#26F05252"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="TargetMissing">
                                                    <Setter Property="Background" Value="#26F05252"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                 Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                                        <TextBlock Text="{Binding StateText}" FontSize="12" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Group}" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LinkPath}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ResolvedLink}" FontSize="11" Foreground="{StaticResource FaintTextBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{StaticResource FaintTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TargetPath}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource FaintTextBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText" Grid.Row="1" Text="Kayıt yok. Sağ üstteki 'Yeni bağlantı' ile ekleyin."
                           Foreground="{StaticResource FaintTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                <!-- Islem surerken -->
                <Border x:Name="BusyPanel" Grid.RowSpan="3" Background="#CC171B21" CornerRadius="10" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Spinner}" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="BusyText" Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Alt islem cubugu -->
                <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="4,6,4,0" Padding="6,12,6,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Click="OpenFolder_Click" ToolTip="Hedef klasörü Gezgin'de aç">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" Style="{StaticResource Icon}"/>
                                    <TextBlock Text="Klasörü aç"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="Edit_Click" Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}"/>
                                    <TextBlock Text="Düzenle"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="Delete_Click" Margin="4,0,0,0" ToolTip="Kaydı listeden siler; diske dokunmaz">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/>
                                    <TextBlock Text="Sil"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DangerButton}" Click="Unlink_Click" Margin="12,0,0,0"
                                    ToolTip="Junction'ı kaldırır; merkezdeki veri yerinde kalır">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}"/>
                                    <TextBlock Text="Bağlantıyı kaldır"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="LinkButton" Style="{StaticResource AccentButton}" Click="Link_Click" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71B;" Style="{StaticResource Icon}"/>
                                    <TextBlock x:Name="LinkButtonText" Text="Tümünü bağla"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
