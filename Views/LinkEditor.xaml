<UserControl x:Class="MetroKafeMklink.Views.LinkEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Ad" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="örn. Riot Client (AppData)"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Grup" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}" Tag="örn. Riot"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Bağlantı yolu (junction'ın duracağı yer)" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseLink_Click" ToolTip="Klasör seç">
                <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}"/>
            </Button>
            <TextBox x:Name="LinkBox" Text="{Binding LinkPath, UpdateSourceTrigger=PropertyChanged}" Tag="örn. %APPDATA%\Riot Client"
                     TextChanged="Path_TextChanged"/>
        </DockPanel>
        <TextBlock x:Name="LinkPreview" Style="{StaticResource Hint}" Margin="2,5,0,0"/>

        <TextBlock Text="Hedef yolu (verinin gerçekte duracağı yer)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseTarget_Click" ToolTip="Klasör seç">
                <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}"/>
            </Button>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="Suggest_Click" ToolTip="Grup ve klasör adına göre merkezde bir yol öner">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE945;" Style="{StaticResource Icon}"/>
                    <TextBlock Text="Öner"/>
                </StackPanel>
            </Button>
            <TextBox x:Name="TargetBox" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Tag="örn. {MERKEZ}\Riot\AppData\Riot Client"
                     TextChanged="Path_TextChanged"/>
        </DockPanel>
        <TextBlock x:Name="TargetPreview" Style="{StaticResource Hint}" Margin="2,5,0,0"/>

        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Content="Etkin (toplu bağlamaya dahil)" Margin="0,18,0,0"/>

        <Border Background="#0F4F8CFF" BorderBrush="#2A4F8CFF" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,18,0,0">
            <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource SubTextBrush}">
                Kullanılabilen değişkenler: <Run FontWeight="SemiBold" Text="{}{MERKEZ}"/> (Ayarlar'daki merkez klasör),
                %APPDATA%, %LOCALAPPDATA%, %PROGRAMDATA%, %USERPROFILE%. Değişken kullanınca aynı kayıt her bilgisayarda
                ve her Windows kullanıcısında doğru yeri gösterir.
            </TextBlock>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
