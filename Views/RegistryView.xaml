<UserControl x:Class="MetroKafeMklink.Views.RegistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="YesNoBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Setter Property="Background" Value="#26F05252"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/>
                        <TextBlock Text="Yenile"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButton}" Margin="10,0,0,0" Click="Add_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}"/>
                        <TextBlock Text="Yeni anahtar"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Registry" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Ana makinedeki anahtarları merkeze .reg olarak al, client'lara tek tıkla uygula" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#0F4F8CFF" BorderBrush="#2A4F8CFF" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,20,0,14">
            <DockPanel>
                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" FontSize="15" Margin="0,0,12,0"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" FontSize="12.5">
                    <Run Text="Ana makinede"/> <Run Text="Dışa aktar" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <Run Text="anahtarı merkezdeki Registry klasörüne yazar. Client'ta"/> <Run Text="İçe aktar" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <Run Text="o dosyayı uygular. Klasör:"/> <Run x:Name="FolderRun" Foreground="{StaticResource TextBrush}"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="13,8,23,8" TextElement.Foreground="{StaticResource FaintTextBrush}" TextElement.FontSize="11.5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="BU BİLGİSAYARDA"/>
                    <TextBlock Grid.Column="1" Text="MERKEZDEKİ .REG"/>
                    <TextBlock Grid.Column="2" Text="AD"/>
                    <TextBlock Grid.Column="3" Text="ANAHTAR"/>
                </Grid>

                <ListBox x:Name="List" Grid.Row="1" SelectionMode="Extended" ItemContainerStyle="{StaticResource RowItem}"
                         MouseDoubleClick="List_MouseDoubleClick" SelectionChanged="List_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource YesNoBadge}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding KeyExists}" Value="True">
                                                    <Setter Property="Background" Value="#262BD46A"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                 Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                                        <TextBlock FontSize="12" Margin="7,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Anahtar yok"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding KeyExists}" Value="True">
                                                            <Setter Property="Text" Value="Anahtar var"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource YesNoBadge}">
                                                <Setter Property="Background" Value="#26F5A524"/>
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FileExists}" Value="True">
                                                        <Setter Property="Background" Value="#262BD46A"/>
                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                     Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                                            <TextBlock FontSize="12" Margin="7,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Alınmadı"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FileExists}" Value="True">
                                                                <Setter Property="Text" Value="Hazır"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding FileInfo}" FontSize="11" Foreground="{StaticResource FaintTextBrush}" Margin="2,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Group, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding FileName, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="{Binding Key}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           FontFamily="Consolas" FontSize="12.5" ToolTip="{Binding Key}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText" Grid.Row="1" Text="Kayıt yok. Sağ üstteki 'Yeni anahtar' ile ekleyin."
                           Foreground="{StaticResource FaintTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                <Border x:Name="BusyPanel" Grid.RowSpan="3" Background="#CC171B21" CornerRadius="10" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Spinner}" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="BusyText" Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="4,6,4,0" Padding="6,12,6,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Click="Regedit_Click" ToolTip="Seçili anahtarı Kayıt Defteri Düzenleyicisi'nde aç">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}"/>
                                    <TextBlock Text="Regedit'te aç"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="Edit_Click" Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}"/>
                                    <TextBlock Text="Düzenle"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="Delete_Click" Margin="4,0,0,0" ToolTip="Kaydı listeden siler; registry'ye dokunmaz">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/>
                                    <TextBlock Text="Sil"/>
                                </StackPanel>
                            </Button>
                            <Button Click="Export_Click" Margin="12,0,0,0" ToolTip="Bu bilgisayardaki anahtarı merkeze .reg olarak yaz">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE898;" Style="{StaticResource Icon}"/>
                                    <TextBlock Text="Dışa aktar"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AccentButton}" Click="Import_Click" Margin="10,0,0,0" ToolTip="Merkezdeki .reg dosyasını bu bilgisayara uygula">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}"/>
                                    <TextBlock Text="İçe aktar"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
